# Environment
venv/
.env
*.pyc
__pycache__/
.DS_Store

# Database — contains scraped personal data; not for public distribution
db/radicalmap.db

# Scraped media — video files are copyrighted third-party content
data/videos/

# Raw comment JSON exports
data/comments/*.json

# AI analysis output — contains raw scraped content
data/fable_results.json

# Temporary / session artefacts
*.log
*.tmp
scratchpad/

# v2 store — same rule as v1: scraped personal data, local only
db/radicalmap.v2.db
db/radicalmap.v2.db-wal
db/radicalmap.v2.db-shm

# Pseudonymisation key. Deliberately NOT in the database: a leaked .db file
# must not be sufficient to reverse commenter hashes.
db/.author_salt

# Deduplicated sound files — copyrighted third-party audio, local analysis only
data/audio/

# Demo database (radicalmap demo) — synthetic, regenerated on every run
db/radicalmap.demo.db
db/radicalmap.demo.db-wal
db/radicalmap.demo.db-shm
